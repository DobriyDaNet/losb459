})

-- Anti Grab
local function FreezeCharacter(character)
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end
    savedCFrame = rootPart.CFrame
    savedPosition = rootPart.Position
    isFrozen = true
    if not rootPart:FindFirstChild("FreezeJoint") then
        local al = Instance.new("AlignPosition")
        local at = Instance.new("Attachment", rootPart)
        al.Name = "FreezeJoint"
        al.Mode = Enum.PositionAlignmentMode.OneAttachment
        al.MaxForce = 1e6
        al.MaxVelocity = 0
        al.Responsiveness = 200
        al.Attachment0 = at
        al.Position = savedPosition
        al.Parent = rootPart
    end
    if freezeConnection then freezeConnection:Disconnect() end
    freezeConnection = RunService.Heartbeat:Connect(function()
        if isFrozen and rootPart and rootPart.Parent then
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = savedCFrame
        end
    end)
end

